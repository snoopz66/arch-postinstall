/* HyDE launcher style 1 (sidebar over the wallpaper): https://github.com/HyDE-Project/HyDE
   The sidebar images in ~/.cache/wallpaper are written by ~/.local/bin/wallpaper */
configuration {
  modes: "drun,calc,window,run";
  show-icons: true;
  display-drun: " ";
  display-run: " ";
  display-window: " ";
  display-calc: " ";
  drun-display-format: "{name}";
  window-format: "{w}{t}";
  font: "JetBrainsMono Nerd Font 10";
  icon-theme: "Tela-circle-dracula";
  terminal: "ghostty";

  /* rofi-calc: Ctrl+Tab from the app list keeps what was typed; Return copies the result */
  calc {
    terse: true;
    no-history: true;
    hint-welcome: "";
    hint-result: "= ";
    calc-command: "printf '%s' '{result}' | wl-copy";
  }
}

@theme "theme"

window {
  height: 33em;
  width: 63em;
  transparency: "real";
  border: 2px;
  border-radius: 30px;
  border-color: @main-br;
  background-color: @main-bg;
  spacing: 0em;
  padding: 0em;
}

mainbox {
  spacing: 0em;
  padding: 0em;
  orientation: horizontal;
  children: [ "dummywall", "listbox" ];
  background-color: transparent;
}

dummywall {
  width: 37em;
  expand: false;
  orientation: horizontal;
  children: [ "mode-switcher", "dummy" ];
  background-color: transparent;
  background-image: url("~/.cache/wallpaper/rofi.png", height);
}

mode-switcher {
  orientation: vertical;
  width: 3.8em;
  padding: 6.5em 0.5em;
  spacing: 1.2em;
  background-color: transparent;
  background-image: url("~/.cache/wallpaper/rofi-blur.png", height);
}

button {
  cursor: pointer;
  border-radius: 2em;
  background-color: @main-bg;
  text-color: @main-fg;
}

button selected {
  background-color: @main-fg;
  text-color: @main-bg;
}

listbox {
  spacing: 0.8em;
  padding: 1.2em 2em;
  children: [ "dummy", "inputbar", "message", "listview", "dummy" ];
  background-color: transparent;
}

inputbar {
  children: [ "entry" ];
  padding: 0.6em 1.2em;
  border-radius: 20px;
  background-color: @main-ex;
  text-color: @main-fg;
}

entry {
  placeholder: "Search";
  placeholder-color: @main-fg;
  cursor: text;
  background-color: transparent;
  text-color: inherit;
}

/* only rofi-calc fills this, with the live result */
message {
  padding: 0.6em 1.2em;
  border-radius: 20px;
  background-color: @select-bg;
}

textbox {
  background-color: transparent;
  text-color: @select-fg;
}

listview {
  columns: 1;
  lines: 8;
  cycle: true;
  dynamic: false;
  scrollbar: false;
  expand: false;
  fixed-height: false; /* true collapses the column once rofi-calc sets its message */
  background-color: transparent;
  text-color: @main-fg;
}

dummy {
  background-color: transparent;
}

element {
  spacing: 0.8em;
  padding: 0.4em 0.4em 0.4em 1.5em;
  border-radius: 20px;
  cursor: pointer;
  background-color: transparent;
  text-color: @main-fg;
}

element selected.normal {
  background-color: @select-bg;
  text-color: @select-fg;
}

element-icon {
  size: 2.2em; /* HyDE has 2.8em; eight of those overflow the window and eat the top margin */
  cursor: inherit;
  background-color: transparent;
  text-color: inherit;
}

element-text {
  vertical-align: 0.5;
  cursor: inherit;
  background-color: transparent;
  text-color: inherit;
}
