/* HyDE launcher style 1 (sidebar over the wallpaper): https://github.com/HyDE-Project/HyDE */
configuration {
  modes: "drun,window,run";
  show-icons: true;
  display-drun: " ";
  display-run: " ";
  display-window: " ";
  drun-display-format: "{name}";
  window-format: "{w}{t}";
  font: "JetBrainsMono Nerd Font 10";
  icon-theme: "Tela-circle-dracula";
  terminal: "ghostty";
}

@theme "theme"

window {
  height: 33em;
  width: 63em;
  transparency: "real";
  border: 2px;
  border-radius: 30px;
  border-color: @main-br;
  background-color: @main-bg;
  spacing: 0em;
  padding: 0em;
}

mainbox {
  spacing: 0em;
  padding: 0em;
  orientation: horizontal;
  children: [ "dummywall", "listbox" ];
  background-color: transparent;
}

dummywall {
  width: 37em;
  expand: false;
  orientation: horizontal;
  children: [ "mode-switcher", "inputbar" ];
  background-color: transparent;
  background-image: @wallpaper;
}

mode-switcher {
  orientation: vertical;
  width: 3.8em;
  padding: 9.2em 0.5em;
  spacing: 1.2em;
  background-color: @main-ex;
}

button {
  cursor: pointer;
  border-radius: 2em;
  background-color: @main-bg;
  text-color: @main-fg;
}

button selected {
  background-color: @main-fg;
  text-color: @main-bg;
}

inputbar {
  children: [ "entry" ];
  background-color: transparent;
}

entry {
  enabled: false;
}

listbox {
  padding: 2em;
  children: [ "dummy", "listview", "dummy" ];
  background-color: transparent;
}

listview {
  columns: 1;
  lines: 8;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  fixed-height: true;
  background-color: transparent;
  text-color: @main-fg;
}

dummy {
  background-color: transparent;
}

element {
  spacing: 0.8em;
  padding: 0.4em 0.4em 0.4em 1.5em;
  border-radius: 20px;
  cursor: pointer;
  background-color: transparent;
  text-color: @main-fg;
}

element selected.normal {
  background-color: @select-bg;
  text-color: @select-fg;
}

element-icon {
  size: 2.8em;
  cursor: inherit;
  background-color: transparent;
  text-color: inherit;
}

element-text {
  vertical-align: 0.5;
  cursor: inherit;
  background-color: transparent;
  text-color: inherit;
}
