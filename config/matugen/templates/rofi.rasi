/* HyDE rofi colors (wallbash/theme/rofi.dcol) mapped to Material roles:
   pry1/pry2 dark surfaces, pry3 border and 4xa8 selection are wallpaper accents, so primary */
* {
  main-bg: #{{colors.surface.default.hex_stripped}}B3;
  main-fg: #{{colors.primary_fixed.default.hex_stripped}}E6;
  main-br: #{{colors.primary.default.hex_stripped}}E6;
  main-ex: #{{colors.surface_container.default.hex_stripped}}E6;
  select-bg: #{{colors.primary.default.hex_stripped}}80;
  select-fg: #{{colors.on_primary.default.hex_stripped}}E6;
}
