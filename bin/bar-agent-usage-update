#!/bin/bash


# bar-agent-usage-update [--force] [--limits-only] [--except <agent>] [agent...]
#
# Each bar-agent-usage-<agent> collector prints one display-ready JSON
# record; this writes them to ~/.local/state/bar/agents/usage/ where the
# agents panel watches them. Adding an agent is adding a collector — the
# panel picks up any record that appears here.

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bar/agents/usage"
mkdir -p "$USAGE_DIR"

flags=()
only=()
declare -A excluded

while (( $# > 0 )); do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    if [[ -z ${2:-} ]]; then
      echo "--except needs an agent" >&2
      exit 1
    else
      excluded[$2]=1
      shift
    fi
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  local record tmp
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "bar-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

# Collectors forced together read the Codex rollouts they share once between
# them, whenever each gets to them, by knowing when this refresh began.
# EPOCHREALTIME uses the locale's decimal separator, a comma in many.
export BAR_AGENT_USAGE_REFRESH_AT=${EPOCHREALTIME/,/.}

pids=()
# The collectors sit beside this script.
bin=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")
for collector in "$bin"/bar-agent-usage-*; do
  [[ -x $collector ]] || continue
  agent="${collector##*/bar-agent-usage-}"
  [[ $agent == "update" ]] && continue
  wanted "$agent" || continue
  collect "$collector" "$agent" &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done

exit $status
