#!/usr/bin/env bash
# wallpaper IMAGE: set wallpaper, regenerate colors, reload the shell
set -euo pipefail

img=$(realpath "$1")
cache=$HOME/.cache/wallpaper
mkdir -p "$cache"

matugen image "$img" --prefer saturation

# the login screen follows: greeter-sync copies `current` for the greeter user
ln -sfn "$img" "$cache/current"
~/.local/bin/greeter-sync

# outside a session (first run from the install script) there is nothing to reload
[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || exit 0

hyprctl hyprpaper wallpaper ",$img"
hyprctl reload
pkill -SIGUSR2 waybar || true
swaync-client -rs
